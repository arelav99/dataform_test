# Copy this file to .env and fill in the values below.
#   cp .env.example .env
#   FERNET_KEY: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# Host user ID so files written by containers are owned by you (Linux/WSL). Run `id -u` to check.
AIRFLOW_UID=1000

# Airflow image. Pinned to the latest release.
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.2

# Host port for the Airflow UI/API (change if 8080 is already in use).
AIRFLOW_PORT=8080

# Encrypts connection secrets in the metadata DB.
FERNET_KEY=

# Secret for signing API tokens. Change it if you expose the instance beyond localhost.
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret

# Web UI login (created on first init).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Extra pip packages installed at container start. Quick checks only; prefer a custom image.
_PIP_ADDITIONAL_REQUIREMENTS=

# GCP project and Dataform repository the DAGs call. Must match workflow_settings.yaml (defaultProject).
GCP_PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID
DATAFORM_REGION=us-central1
DATAFORM_REPOSITORY_ID=REPLACE_WITH_DATAFORM_REPOSITORY_ID
